{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "license": "${license}",
  "environment": "server",
  "entrypoints": {
    "server": [
      "com.mtmrails.esscmd.fabric.CmdEssentialsFabric"
    ]
  },
  "mixins": [
    "cmdessentials.common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*"
  }
}
